// Windows version resource for Am-Q.clap and Am-Q.vst3 (plugin/CMakeLists.txt). The numbers and
// strings come from the generated amq_version.h (cmake/gen_version.cmake).
#include <winver.h>
#include "amq_version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION AMQ_VERSION_MAJOR, AMQ_VERSION_MINOR, AMQ_VERSION_PATCH, 0
 PRODUCTVERSION AMQ_VERSION_MAJOR, AMQ_VERSION_MINOR, AMQ_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Am-Q 24-band parametric EQ"
            VALUE "FileVersion", AMQ_VERSION_FULL
            VALUE "InternalName", "Am-Q"
            VALUE "ProductName", "Am-Q"
            VALUE "ProductVersion", AMQ_VERSION_FULL
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
