# Store and check out text files with LF line endings on every platform.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets.
*.png  binary
*.jpg  binary
*.ico  binary
*.icns binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.wav  binary
*.flac binary
*.pdf  binary
*.dmp  binary
