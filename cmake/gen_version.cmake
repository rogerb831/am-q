# Writes the build's version header (amq_version.h) and amq_version.txt, run at every build by the
# amq_version target (CMakeLists.txt) so the commit in a development version stays current.
#
#   AMQ_VERSION_FULL = VERSION                     on a commit tagged v<VERSION> (a release)
#                    = VERSION+<short hash>        otherwise
#                    = VERSION+<short hash>.dirty  with uncommitted changes to tracked files
#
# The files are rewritten only when their content changes, so an unchanged version rebuilds
# nothing. Inputs: VERSION, VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, SOURCE_DIR, OUT_DIR.

cmake_minimum_required(VERSION 3.24)  # script mode: policies (IN_LIST) as in the project

set(full "${VERSION}")
find_program(GIT_EXE git)
if(GIT_EXE)
    execute_process(COMMAND "${GIT_EXE}" rev-parse --short=7 HEAD WORKING_DIRECTORY "${SOURCE_DIR}"
                    OUTPUT_VARIABLE hash OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE r1)
    execute_process(COMMAND "${GIT_EXE}" tag --points-at HEAD WORKING_DIRECTORY "${SOURCE_DIR}"
                    OUTPUT_VARIABLE tags OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    execute_process(COMMAND "${GIT_EXE}" status --porcelain --untracked-files=no WORKING_DIRECTORY "${SOURCE_DIR}"
                    OUTPUT_VARIABLE dirty OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    string(REPLACE "\n" ";" tags "${tags}")
    set(release FALSE)
    if("v${VERSION}" IN_LIST tags)
        set(release TRUE)
    endif()
    # A CI tag build may check out the commit without its tag ref.
    if("$ENV{GITHUB_REF_TYPE}" STREQUAL "tag" AND "$ENV{GITHUB_REF_NAME}" STREQUAL "v${VERSION}")
        set(release TRUE)
    endif()
    if(r1 EQUAL 0 AND NOT release)
        set(full "${VERSION}+${hash}")
        if(NOT dirty STREQUAL "")
            string(APPEND full ".dirty")
        endif()
    endif()
endif()

set(header "// Generated by cmake/gen_version.cmake. Do not edit.
#pragma once
#define AMQ_VERSION \"${VERSION}\"
#define AMQ_VERSION_FULL \"${full}\"
#define AMQ_VERSION_MAJOR ${VERSION_MAJOR}
#define AMQ_VERSION_MINOR ${VERSION_MINOR}
#define AMQ_VERSION_PATCH ${VERSION_PATCH}
")

function(write_if_changed path content)
    if(EXISTS "${path}")
        file(READ "${path}" old)
        if(old STREQUAL content)
            return()
        endif()
    endif()
    file(WRITE "${path}" "${content}")
endfunction()

file(MAKE_DIRECTORY "${OUT_DIR}")
write_if_changed("${OUT_DIR}/amq_version.h" "${header}")
write_if_changed("${OUT_DIR}/amq_version.txt" "${full}\n")
